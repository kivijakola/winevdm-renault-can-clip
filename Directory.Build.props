<?xml version="1.0" encoding="utf-8"?>
<!-- Force VS 2022 toolset + installed Win10 SDK. Command-line /p: still wins. -->
<Project>
  <PropertyGroup>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'=='10.0.17134.0' or '$(WindowsTargetPlatformVersion)'==''">10.0.22621.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
